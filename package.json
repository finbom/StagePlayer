{
  "name": "stageplayer",
  "productName": "StagePlayer",
  "version": "0.1.0",
  "description": "A simple music and sound player for musical theatre rehearsals.",
  "main": "dist/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "Finbom",
  "repository": "github:finbom/StagePlayer",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.stageplayer.app",
    "productName": "StagePlayer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "mac": {
      "icon": "stageplayer-brand/desktop/icon.icns"
    },
    "win": {
      "icon": "stageplayer-brand/desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@45.3.1": true
  }
}
